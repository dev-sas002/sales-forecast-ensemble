# Every setting is optional; the defaults run the demo end to end.
# For a local run, export the ones you need. Docker Compose reads a .env file
# (git-ignored) in this directory for HASH_SALT and ANTHROPIC_API_KEY.

# Key for the HMAC that hashes customer ids before panel linkage. The default
# is public, so set your own for anything but the generated demo data.
# HASH_SALT=replace-with-a-long-random-string

# Where the pipeline writes its working data and where trained boosters go.
# DATA_DIR=./data
# MODEL_DIR=./artifacts/models

# The API the dashboard's API tab talks to.
# API_URL=http://localhost:8000

# Optional AI narration for /explain (also needs `pip install anthropic`).
# Without it the same facts are rendered from a template.
# ANTHROPIC_API_KEY=

# Optional MLflow tracking server for src/mlops/mlflow_utils.py.
# MLFLOW_TRACKING_URI=
